# Default: MiniMax. Fill in a newly generated key locally.
IE_AGENT_MODEL_PROVIDER=minimax
MINIMAX_API_KEY=
# Mainland China; global account: https://api.minimax.io/v1
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_MAX_TOKENS=8192
MINIMAX_TIMEOUT_SECONDS=120

# Optional legacy provider; only used when IE_AGENT_MODEL_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
IE_AGENT_PLANNER=hybrid
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT_SECONDS=120
IE_AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
IE_AGENT_KNOWLEDGE_DIR=knowledge/demo
IE_AGENT_RAG_BACKEND=tfidf
IE_AGENT_TOP_K=5
IE_AGENT_DEVICE=auto
IE_AGENT_MAX_ROUNDS=3
IE_AGENT_RUNS_DIR=runs
